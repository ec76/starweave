# Copy to .env.local for development. Never use NEXT_PUBLIC_ for SQL settings.
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your-database

# Optional server-only origin for article-page canonicals. Leave unset until known.
# SITE_ORIGIN=https://your-approved-host.example

# Administrator-created password accounts. No deployed delivery provider yet.
# Nonsecret identifiers/origin; HTTPS is required, including local development.
# ADMIN_AUTH_ORIGIN=https://localhost:3001
# SECRET: 32 random bytes encoded as unpadded base64url. Different per environment.
# ADMIN_AUTH_SECRET=your-43-character-base64url-key
# Development only, loopback Mailpit inbox. Explicitly refused on App Service.
# AUTH_EMAIL_DELIVERY=development-preview

# Optional sanitized local sign-in diagnostics. Development only; refused in Azure.
# AUTH_DEBUG=1

# Password sessions: default 12 hours, bounded to 1 hour through 7 days.
# ADMIN_SESSION_SECONDS=43200
# Local disposable route verification only; leave disabled normally.
# AUTH_INTEGRATION=0
# AUTH_VERIFY_ADMIN_EMAIL=initial@example.invalid
# AUTH_VERIFY_ALLOW_SELF_SIGNED=0
